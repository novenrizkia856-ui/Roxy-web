# =============================================================================================
# Recur - web app environment
#
# Copy to .env for local development. On Vercel, set these in the project's Environment
# Variables rather than committing a file.
#
# Everything here is public: VITE_* values are inlined into the client bundle at build time.
# Never put a private key or any secret in this file.
# =============================================================================================

# Robinhood Chain mainnet. Verified live: eth_chainId returns 0x1237 (4663).
VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Testnet is chain 46630 at https://rpc.testnet.chain.robinhood.com. Note that the testnet has
# no Uniswap and no Chainlink deployed, so a testnet build only works against the mock stack -
# see recur-contracts/docs/PHASE0_NETWORK_NOTES.md gap G3.

# Deployed Recur address, from recur-contracts/deployments/<network>.json.
# Left blank, the app runs in a read-only mode and says so rather than failing.
VITE_RECUR_CONTRACT_ADDRESS=

# Blockscout. Used to build the transaction and address links shown after each write.
VITE_BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Free project id from https://cloud.reown.com (formerly WalletConnect Cloud).
# Without it, injected wallets such as MetaMask still work; WalletConnect ones do not.
VITE_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------------------------
# Local development only. Both are ignored by a production build.
# ---------------------------------------------------------------------------------------------

# Overrides the built-in Stock Token candidate list with a single address. Needed against a
# throwaway chain, where every deploy produces fresh addresses.
VITE_STOCK_TOKEN_ADDRESS=

# Set to "true" to install src/lib/devWallet.ts: an EIP-1193 provider that forwards to the local
# node so the approve / createPlan / cancel flow can be driven without a browser extension. It
# holds no key - it relies on the node having unlocked the account, which only a dev node does.
# Vite drops the module entirely from a production build.
VITE_DEV_WALLET=
